# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Portfolio Enquiry Backend (Python / Vercel Environment Variables)
# Email address where enquiries are delivered:
CONTACT_RECEIVER_EMAIL="konasomanathreddy@gmail.com"

# Option A: SMTP Delivery (e.g. Gmail SMTP with App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# Option B: Resend HTTP API (recommended for Vercel serverless)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Portfolio Enquiry <onboarding@resend.dev>"

# Optional bearer token to inspect stored enquiries via GET /api/enquiry
ENQUIRY_ADMIN_TOKEN=""
